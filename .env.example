# ============================================================
# PROVENTA — Environment Variables
# Copy this file to .env.local and fill in all values
# NEVER commit .env.local or any file with real secrets
# ============================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Proventa
NEXT_PUBLIC_LAUNCH_STATE=PRE_LAUNCH
# Options: PRE_LAUNCH | WAVE1_OPEN | ACTIVE

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/proventa"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL=http://localhost:3000

# Google OAuth (optional in dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI — Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
GEMINI_FLASH_MODEL=gemini-1.5-flash

# Email — Resend
RESEND_API_KEY=
EMAIL_FROM=Proventa <hello@proventa.in>
EMAIL_REPLY_TO=concierge@proventa.in

# File Storage — AWS S3 or Cloudflare R2
STORAGE_PROVIDER=s3
# Options: s3 | r2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=proventa-uploads
# For Cloudflare R2:
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=proventa-uploads

# Redis (for BullMQ background jobs)
REDIS_URL=redis://localhost:6379

# Payments — Razorpay (NOT activated in Wave 1)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Security
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"
# Used for encrypting sensitive config values in DB

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Feature Flags (can also be managed from admin panel)
FEATURE_WAVE1_REGISTRATION=true
FEATURE_GOOGLE_AUTH=false
FEATURE_AI_ENABLED=false
FEATURE_PAYMENTS_ENABLED=false

# Operations
SLA_INITIAL_RESPONSE_MINUTES=30
SLA_OPTIONS_HOURS=2
SLA_EXECUTION_HOURS=4
AI_CONFIDENCE_THRESHOLD=0.7
AI_HANDOFF_AMOUNT_INR=10000

# Logging
LOG_LEVEL=info
# Options: trace | debug | info | warn | error
